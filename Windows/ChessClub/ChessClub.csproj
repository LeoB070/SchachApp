<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeinSchachclub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Gera.Chess" Version="1.2.0" />
    <AvaloniaResource Include="../../Sources/ChessAppKit/Resources/Chessnut/*.png" Link="Assets/%(Filename)%(Extension)" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY.md" Link="THIRD_PARTY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/puzzles.json" Link="Data/puzzles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/openings.json" Link="Data/openings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/lessons/*.json" Link="Data/lessons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/Chessnut/*.txt" Link="Data/licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/OPENINGS-*.txt" Link="Data/licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
