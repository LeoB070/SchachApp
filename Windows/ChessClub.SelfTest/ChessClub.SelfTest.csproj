<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><PackageReference Include="Gera.Chess" Version="1.2.0"/><Compile Include="../ChessClub/Core/*.cs" Link="Core/%(Filename)%(Extension)"/><Compile Include="../ChessClub/LocalStore.cs" Link="LocalStore.cs"/></ItemGroup>
  <ItemGroup>
    <Content Include="../../Sources/ChessAppKit/Resources/puzzles.json" Link="Data/puzzles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/openings.json" Link="Data/openings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Sources/ChessAppKit/Resources/lessons/*.json" Link="Data/lessons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
